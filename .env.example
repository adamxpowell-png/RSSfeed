DATABASE_URL=postgresql://user:password@localhost:5432/rss_reader
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=noreply@yourdomain.com
EMAIL_TO=your.email@example.com
PORT=3000
NODE_ENV=development

# Security (required in production - API returns 503 without a password)
# READER_PASSWORD is accepted as a fallback for existing deployments
APP_PASSWORD=choose_a_strong_password
SESSION_SECRET=random_string_for_cookie_signing

# Per-instance branding (optional)
APP_NAME=RSS Feed Reader
APP_COLOR=#3498db
APP_URL=https://your-instance.up.railway.app

# Talkwalker Alerts combined RSS URL. Treat as a secret: the URL itself
# grants read access to the alert stream. Used only by `npm run seed`.
TALKWALKER_ALERTS_RSS=
