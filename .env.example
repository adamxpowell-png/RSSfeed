DATABASE_URL=postgresql://user:password@localhost:5432/rss_reader
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=noreply@yourdomain.com
EMAIL_TO=your.email@example.com
PORT=3000
NODE_ENV=development

# Security. BOTH are required: the API fails closed (503) unless a password AND
# a session secret are set. This applies in every environment, not just production.
# READER_PASSWORD is accepted as a fallback for APP_PASSWORD on existing deployments.
APP_PASSWORD=choose_a_strong_password
# SESSION_SECRET signs the auth cookie. Set it to a long, independent random value
# (e.g. `openssl rand -hex 32`). NEVER reuse the password. Unique per instance.
# In production an unset secret means the API returns 503 until you set one.
SESSION_SECRET=generate_with_openssl_rand_hex_32

# Per-instance branding (optional)
APP_NAME=RSS Feed Reader
APP_COLOR=#3498db
APP_URL=https://your-instance.up.railway.app

# Talkwalker Alerts combined RSS URL. Treat as a secret: the URL itself
# grants read access to the alert stream. Used only by `npm run seed`.
TALKWALKER_ALERTS_RSS=
